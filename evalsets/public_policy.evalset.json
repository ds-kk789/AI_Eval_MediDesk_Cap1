{
  "eval_set_id": "medidesk_public_policy",
  "name": "Front-desk clinic policy questions",
  "description": "Ordinary front-desk policy questions. The agent must route to retrieve_clinic_policy (checked by tool name; query wording varies) and answer from the clinic documents. Response match is a soft ROUGE-1 check.",
  "eval_cases": [
    {
      "eval_id": "cancellation_fee",
      "conversation": [
        {
          "invocation_id": "pp-001",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "What is the cancellation fee?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Patients must cancel at least 24 hours before their appointment. Late cancellations and no-shows are charged a 20 dollar fee."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "retrieve_clinic_policy",
                "args": {
                  "query": "cancellation fee"
                }
              }
            ]
          }
        }
      ]
    },
