# Copy to .env and fill in. Key names only -- never commit real values.

# Required: Groq API key powers /ask, the ADK agent and the DeepEval judge.
GROQ_API_KEY=

# Optional backup key(s). When the first returns a daily-quota 429, every
# call site rotates to the next (backend/llm.py).
GROQ_API_KEY_2=

# Optional: if set and in quota, the ADK lane uses Gemini as the agent model.
GOOGLE_API_KEY=

# Optional overrides (defaults shown in backend/config.py)
# APP_HOST=127.0.0.1
# APP_PORT=8003
# FRONT_DESK_API_KEY=front-desk-demo-key
# CLINICIAN_API_KEY=clinician-demo-key
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_JUDGE_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-2.0-flash
# QUALITY_THRESHOLD=0.95
# Comma-separated browser origins allowed to call the API (the web app)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
